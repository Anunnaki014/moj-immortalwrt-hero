/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/input/input.h>

/ {
	model = "Keenetic Hero/Giga (KN-1012)";
	compatible = "keenetic,kn-1012", "mediatek,mt7981";

	chosen {
		bootargs = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000";
	};

	keys {
		compatible = "gpio-keys";

		button-wps {
			label = "wps";
			gpios = <&pio 0 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
		};

		button-fn {
			label = "fn";
			gpios = <&pio 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_FN>;
		};

		button-reset {
			label = "reset";
			gpios = <&pio 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};

	leds {
		compatible = "gpio-leds";

		system {
			label = "green:system";
			gpios = <&pio 11 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};

		fn1 {
			label = "green:fn1";
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
		};

		internet {
			label = "green:internet";
			gpios = <&pio 12 GPIO_ACTIVE_LOW>;
		};

		fn2 {
			label = "green:fn2";
			gpios = <&pio 13 GPIO_ACTIVE_LOW>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x20000000>;
	};

	reg_fixed_3p3v: regulator-33v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-3.3V";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};

	reg_fixed_5v: regulator-5v {
		compatible = "regulator-fixed";
		regulator-name = "fixed-5V";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};

	sfp0: sfp-p5 {
		compatible = "sff,sfp";
		i2c-bus = <&i2c0>;
		mod-def0-gpios = <&pio 23 GPIO_ACTIVE_LOW>;
		los-gpios = <&pio 1 GPIO_ACTIVE_HIGH>;
		tx-fault-gpios = <&pio 10 GPIO_ACTIVE_HIGH>;
		tx-disable-gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
		power-gpios = <&pio 28 GPIO_ACTIVE_HIGH>;
		mux-gpios = <&pio 27 GPIO_ACTIVE_LOW>;
		led-gpios = <&pio 25 GPIO_ACTIVE_LOW>;
		maximum-power-milliwatt = <3000>;
	};
};

&uart0 {
	status = "okay";
};

&watchdog {
	status = "okay";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c_pins_g1>;
	status = "okay";
};

&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	spi_nand: spi_nand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <52000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
	};
};

&eth {
	status = "okay";
	mediatek,gsw = <&gsw>;
	mediatek,phy = <&gbe0>;
};

&gsw {
	compatible = "mediatek,mt7531";
	reg = <0>;
	interrupt-parent = <&pio>;
	interrupts = <38 IRQ_TYPE_LEVEL_HIGH>, <0 IRQ_TYPE_LEVEL_LOW>;
	interrupt-names = "gsw", "intb";
	sfp = <&sfp0>;
	status = "okay";
};

&hnat {
	eth-max-mac = <2>;
	status = "okay";
};

&usb_phy {
	status = "okay";
};

&xhci {
	mediatek,u3p-dis-msk = <0x0>;
	phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
	vusb33-supply = <&reg_fixed_3p3v>;
	vbus-supply = <&reg_fixed_5v>;
	status = "okay";
};

&wbsys {
	status = "okay";
};

&wed {
	wdma_rx_ring_depth = <1024>;
	wdma_tx_ring_depth = <1024>;
	status = "okay";
};

&pio {
	spi0_flash_pins: spi0-pins-16-to-21 {
		mux {
			function = "spi";
			groups = "spi0", "spi0_wp_hold";
		};
		conf-pu {
			pins = "SPIO_CS", "SPIO_HOLD", "SPIO_WP";
			drive-strength = <8>;
			mediatek,pull-up-adv = <3>;
		};
		conf-pd {
			pins = "SPIO_CLK", "SPIO_MOSI", "SPIO_MISO";
			drive-strength = <8>;
			mediatek,pull-down-adv = <3>;
		};
	};

	i2c_pins_g1: i2c-pins-30-31 {
		mux {
			function = "i2c";
			groups = "i2c0_1";
		};
	};
};

&wmac {
	status = "okay";
	mediatek,mtd-eeprom = <&factory 0x0>;
	pinctrl-names = "default";
	pinctrl-0 = <&wlan_pins>;
};
